# Copy to .env and adjust. .env is ignored by git - never commit passwords.
# On the course server deploy/setup-server.sh creates it for you.

# Prefix for container/volume names (unique per group on a shared Docker host)
COMPOSE_PROJECT_NAME=batterywatch-llv

# --- Host ports (group LLV range on the course server: 20800-20899) ---
WEB_PORT=20800
API_PORT=20801
DB_PORT=20832
# 127.0.0.1 = database only reachable on the server / via SSH tunnel, 0.0.0.0 = from the internet
DB_BIND=127.0.0.1
MQTT_PORT=20883

# --- PostgreSQL ---
POSTGRES_DB=batterywatch
POSTGRES_USER=batterywatch
POSTGRES_PASSWORD=change-me

# --- Broker the collector subscribes to ---
# Default: the local Mosquitto container (fed by the test publisher).
# For the shared live broker of the course (credentials: tinf25d-llv.yaml) use e.g.:
#   COLLECTOR_MQTT_HOST=<host>
#   COLLECTOR_MQTT_PORT=8883
#   COLLECTOR_MQTT_TLS=true
#   COLLECTOR_MQTT_USERNAME=tinf25d-llv
#   COLLECTOR_MQTT_PASSWORD=...
COLLECTOR_MQTT_HOST=mqtt
COLLECTOR_MQTT_PORT=1883
COLLECTOR_MQTT_TLS=false
COLLECTOR_MQTT_USERNAME=
COLLECTOR_MQTT_PASSWORD=
# live broker: traffic-nodes/<device_id>/measurements (second entry: older recordings)
COLLECTOR_MQTT_TOPIC=traffic-nodes/+/measurements,traffic-device/+/+/+/status
COLLECTOR_MQTT_CLIENT_ID=batterywatch-llv-collector

# --- Status rules (see docs/Statusregeln.md) ---
SHUNT_RESISTANCE_OHM=0.002
BATTERY_SOC_CURVE=10.5:0,12.7:100
STATUS_CRITICAL_BELOW=20
STATUS_LOW_BELOW=50
SMOOTHING_MINUTES=60
STALE_AFTER_MINUTES=45
