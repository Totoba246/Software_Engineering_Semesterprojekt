# =============================================================================
#  BatteryWatch settings - TEMPLATE
# =============================================================================
#  How this works:
#   - Copy this file to ".env" (same folder) and fill in the passwords:
#         cp .env.example .env
#     On the course server, ./deploy/setup-server.sh does this for you and asks
#     for the passwords.
#   - docker-compose.yml reads .env and passes the values to the containers.
#   - .env is listed in .gitignore, so it is NEVER uploaded to GitHub.
#     This template (.env.example) IS on GitHub -> never put real passwords here!
#  Format: NAME=value, no spaces around "=". Lines starting with # are comments.
#  After changing .env:  docker compose up -d   (recreates changed containers)
# =============================================================================

# Prefix for all container and volume names, e.g. "batterywatch-llv-db-1".
# Must be unique on the server, because other groups run Docker there too.
COMPOSE_PROJECT_NAME=batterywatch-llv

# --- Ports on the server -----------------------------------------------------
# Our group (LLV) may use the server ports 20800-20899 (see Portbereiche_TINF25D-KI.xlsx).
# Each line: which server port leads to which part of the system.

# The web page. Open http://212.227.31.76:20800 in a browser. Reachable from the internet.
WEB_PORT=20800
# The REST API (the web page fetches its data from here). Only on the server itself.
# Interactive API documentation: http://127.0.0.1:20801/docs (on the server / via SSH tunnel)
API_PORT=20801
# Our PostgreSQL database (connect with DBeaver/pgAdmin via SSH tunnel, see docs/Server.md).
DB_PORT=20832
# Who may connect to the database port:
#   127.0.0.1 = only programs on the server itself (and SSH tunnels)  <- recommended
#   0.0.0.0   = anyone on the internet who knows the password
DB_BIND=127.0.0.1
# Our own test MQTT broker (not the course broker). Only on the server itself.
MQTT_PORT=20883

# --- Our database ------------------------------------------------------------
# Name, user and password of OUR database. Created automatically on the very
# first start. Changing the password later does NOT change it in an existing
# database (it is only used when the database is created).
POSTGRES_DB=batterywatch
POSTGRES_USER=batterywatch
POSTGRES_PASSWORD=change-me

# --- Which MQTT broker the collector listens to ------------------------------
# The collector is the program that receives the node messages and saves them.
# Default below: our own test broker container "mqtt" (fed by the test publisher).
# For the REAL nodes use the course broker (credentials: tinf25d-llv.yaml, never commit it):
#   COLLECTOR_MQTT_HOST=mqtt.ti-labs.ai
#   COLLECTOR_MQTT_PORT=8883              <- 8883 = MQTT with encryption (TLS)
#   COLLECTOR_MQTT_TLS=true
#   COLLECTOR_MQTT_USERNAME=tinf25d-llv
#   COLLECTOR_MQTT_PASSWORD=...
COLLECTOR_MQTT_HOST=mqtt
COLLECTOR_MQTT_PORT=1883
COLLECTOR_MQTT_TLS=false
COLLECTOR_MQTT_USERNAME=
COLLECTOR_MQTT_PASSWORD=
# Topics = the "addresses" messages are sent to. "+" matches anything in that place.
# Node 101 sends to traffic-nodes/101/measurements. The second entry is the older
# format used in the recorded sample data. Several topics are separated by commas.
COLLECTOR_MQTT_TOPIC=traffic-nodes/+/measurements,traffic-device/+/+/+/status
# Our name at the broker. Must be unique: two clients with the same name kick each other out.
COLLECTOR_MQTT_CLIENT_ID=batterywatch-llv-collector

# --- Battery rules (details: docs/Statusregeln.md) ---------------------------
# The node measures behind a small resistor (shunt), so we add its voltage drop:
#   U_battery = 0.002 Ohm * I_measured + U_measured     (in mV and mA)
SHUNT_RESISTANCE_OHM=0.002
# Battery voltage (VOLTS) -> charge level (%). "10.5:0,12.7:100" means
# 10.5 V = 0 %, 12.7 V = 100 %, linear in between. PLACEHOLDER until the battery type is known.
BATTERY_SOC_CURVE=10.5:0,12.7:100
# Charge level below 20 % = "Kritisch" (red), below 50 % = "Niedrig" (yellow), else "Gut" (green)
STATUS_CRITICAL_BELOW=20
STATUS_LOW_BELOW=50
# Single readings jump around, so the "current" voltage is the average of the last 60 minutes.
SMOOTHING_MINUTES=60
# Node 101 sends every 15 minutes. No valid measurement for 45 minutes = shown in red as outdated.
STALE_AFTER_MINUTES=45

# --- Login (details: backend/batterywatch/config.py) -------------------------
# Accounts are NOT configured here: the first admin is created by `python start.py`
# (or deploy/setup-server.sh), all others on the website (Nutzerverwaltung).
# How long a login stays valid (hours). 168 = 7 days.
SESSION_HOURS=168
# true = send the login cookie only over HTTPS. Keep false for http://localhost / http://<ip>:20800
COOKIE_SECURE=false
# After this many wrong passwords a username is blocked for LOGIN_LOCK_MINUTES.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=5
